# ═══════════════════════════════════════════════════════════════
# HyperArbitrage Bot Engine — Credentials
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials:
#   cp .env.bots .env
#
# For each bot, you need:
#   - ACCOUNT_ADDRESS: Your Hyperliquid wallet address (0x...)
#   - API_KEY: The agent wallet private key (hex, without 0x prefix)
#   - SUB_ACCOUNT: (Optional) Sub-account address for isolated trading
#
# How to get these:
#   1. Go to https://app.hyperliquid.xyz
#   2. Settings → API → Create Agent Wallet
#   3. Copy the private key (that's your API_KEY)
#   4. Your main wallet address is the ACCOUNT_ADDRESS
#   5. If you use sub-accounts, the sub-account address is SUB_ACCOUNT
# ═══════════════════════════════════════════════════════════════

# ── Bot 1: Long XYZ / Short CASH ──
BOT_1_ACCOUNT_ADDRESS=
BOT_1_API_KEY=
BOT_1_SUB_ACCOUNT=

# ── Bot 2: Long XYZ / Short KM ──
BOT_2_ACCOUNT_ADDRESS=
BOT_2_API_KEY=
BOT_2_SUB_ACCOUNT=

# ── Bot 3: Long XYZ / Short FLX ──
BOT_3_ACCOUNT_ADDRESS=
BOT_3_API_KEY=
BOT_3_SUB_ACCOUNT=

