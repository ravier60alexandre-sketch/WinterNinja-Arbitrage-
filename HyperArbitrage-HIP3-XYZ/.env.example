# ═══════════════════════════════════════════════════
# HyperArbitrage HIP-3 XYZ — Environment Variables
# ═══════════════════════════════════════════════════

# Application
APP_ENV=production
APP_SECRET_KEY=<generate-256bit-random>
MASTER_ENCRYPTION_KEY=<fernet-key>

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=/secrets/jwt_rs256.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_rs256.pub

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hyperarbitrage
POSTGRES_USER=hyperarb
POSTGRES_PASSWORD=<strong-password>
DATABASE_URL=postgresql+asyncpg://hyperarb:<password>@postgres:5432/hyperarbitrage
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=<redis-password>

# Bot 1: Long XYZ / Short CASH
BOT_1_ACCOUNT_ADDRESS=0x...
BOT_1_API_KEY=<private-key-hex>
BOT_1_SUB_ACCOUNT=0x...

# Bot 2: Long XYZ / Short KM
BOT_2_ACCOUNT_ADDRESS=0x...
BOT_2_API_KEY=<private-key-hex>
BOT_2_SUB_ACCOUNT=0x...

# Bot 3: Long XYZ / Short FLX
BOT_3_ACCOUNT_ADDRESS=0x...
BOT_3_API_KEY=<private-key-hex>
BOT_3_SUB_ACCOUNT=0x...

# Bot 4: Short XYZ / Long CASH
BOT_4_ACCOUNT_ADDRESS=0x...
BOT_4_API_KEY=<private-key-hex>
BOT_4_SUB_ACCOUNT=0x...

# Bot 5: Short XYZ / Long KM
BOT_5_ACCOUNT_ADDRESS=0x...
BOT_5_API_KEY=<private-key-hex>
BOT_5_SUB_ACCOUNT=0x...

# Bot 6: Short XYZ / Long FLX
BOT_6_ACCOUNT_ADDRESS=0x...
BOT_6_API_KEY=<private-key-hex>
BOT_6_SUB_ACCOUNT=0x...

# Hyperliquid
HL_MAINNET=true
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_HTTP_URL=https://api.hyperliquid.xyz

# Pair names
PAIR_XYZ=XYZ
PAIR_CASH=CASH
PAIR_KM=KM
PAIR_FLX=FLX

# Bot defaults
DEFAULT_PERCENTILE=0.75
DEFAULT_TIMEFRAME_HOURS=6
DEFAULT_PROFIT_MARGIN_BPS=5
DEFAULT_MAX_SLIPPAGE_TICKS=2
DEFAULT_MAX_POSITION_SIZE=1000
DEFAULT_FUNDING_THRESHOLD=0.5
ONE_LEG_TIMEOUT_MS=500
ORDER_RETRY_COUNT=3

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=ERROR

# Frontend
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com
NEXT_PUBLIC_APP_NAME=HyperArbitrage HIP-3

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/hyperarbitrage/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=7

# Domain / SSL
DOMAIN=your-domain.com
SSL_EMAIL=admin@your-domain.com
